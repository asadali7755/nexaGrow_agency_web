# ─────────────────────────────────────────────────────────────
# NexaGrow Agency — environment configuration
#
# Copy to .env.local for local dev, and set the SAME keys in
# Vercel → Project → Settings → Environment Variables (Production).
#
# A missing value in Vercel is what previously made the live site
# render dead `wa.me/undefined` links and drop every contact form
# submission. Set them in BOTH places.
# ─────────────────────────────────────────────────────────────

# Canonical site URL. No trailing slash.
# Drives metadata, canonicals, sitemap.xml, robots.txt and JSON-LD.
# Set this to the real domain the moment it is registered and attached in Vercel.
NEXT_PUBLIC_SITE_URL=https://markiting-services-web.vercel.app

# WhatsApp number: country code + number, digits only. No "+", no spaces.
# Pakistan example: 923001234567 | UAE example: 971501234567
# Leave blank and the floating button links to /contact instead of breaking.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Inbox that receives website leads (shown publicly on the site).
NEXT_PUBLIC_CONTACT_EMAIL=leoali851@gmail.com

# Resend sender. MUST be on a domain verified in Resend.
# A free inbox (gmail.com, outlook.com) is rejected by Resend and the
# lead silently disappears — this was the original bug.
LEADS_FROM_EMAIL=NexaGrow Website <onboarding@resend.dev>

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# GA4 measurement ID — https://analytics.google.com (Admin → Data Streams)
# Without this there is no way to see traffic, sources or conversions.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public social profiles. These feed schema.org sameAs, which is how
# Google and AI answer engines connect the website to the brand entity.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
